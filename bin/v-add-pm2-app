#!/bin/bash
# info: compatibility wrapper for adding a Node.js app to PM2
# options: USER DOMAIN ENTRYPOINT
#
# example: v-add-pm2-app admin wonderland.com
#
# This wrapper keeps older plugin revisions working.
#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

user=$1
domain=$2
entrypoint=$3

if [ "$entrypoint" != 'ecosystem.config.js' ]; then
	echo 'Error: Invalid Node.js entrypoint'
	exit 1
fi

exec /usr/local/hestia/bin/v-add-nodejs-app "$user" "$domain"
